{
  "name": "@paymap/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "pnpm run db:generate && tsc -p tsconfig.json --noEmit",
    "build": "pnpm run db:generate && tsc -p tsconfig.json",
    "test": "prisma migrate deploy --schema ../../prisma/schema.prisma && pnpm run db:generate && vitest run",
    "db:generate": "prisma generate --schema ../../prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^10.2.2",
    "@paymap/config": "workspace:*",
    "@paymap/contract-client": "workspace:*",
    "@paymap/shared": "workspace:*",
    "@paymap/stellar": "workspace:*",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.2.1",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^16.1.0",
    "@types/node": "^22.10.5",
    "prisma": "^6.19.3",
    "vitest": "^2.1.8"
  }
}
