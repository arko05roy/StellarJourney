# Postgres connection string used by Prisma and apps/api.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/paymap?schema=public"

# Redis connection string used by BullMQ (apps/relayer, apps/api webhooks).
REDIS_URL="redis://localhost:6379"

# Stellar network the contract and clients target: "testnet" | "futurenet" | "local".
STELLAR_NETWORK="testnet"

# Soroban RPC endpoint used for simulation and transaction submission.
SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"

# Horizon endpoint used for account/sequence/legacy queries.
HORIZON_URL="https://horizon-testnet.stellar.org"

# Deployed mandate-registry contract id (set after `scripts/deploy-testnet.ts`).
# Since Phase 7, the authoritative copy of this (plus the wasm hash and test
# asset contract id) lives in `deployments/<network>.json`, loaded via
# `packages/contract-client`'s `loadDeployment()` — this env var is what
# apps/api and apps/relayer (Phase 8+) read directly at runtime.
MANDATE_CONTRACT_ID=""

# Secret key for the relayer's Stellar account. Zero spending authority over
# user funds — only pays network fees and submits pre-validated invocations.
RELAYER_SECRET_KEY=""

# Symmetric key used to encrypt merchant webhook endpoint secrets at rest.
WEBHOOK_ENCRYPTION_KEY=""

# Symmetric key used to encrypt merchant-signed Soroban authorization XDR.
# Keep separate from webhook encryption so either key can rotate independently.
AUTHORIZATION_ENCRYPTION_KEY=""

# Pepper mixed into merchant API-key and dashboard-session hashing.
API_KEY_HASH_SECRET=""

# User-visible audience bound into merchant wallet sign-in challenges.
MERCHANT_AUTH_DOMAIN="localhost:3000"

# apps/web (Phase 10 consumer checkout, Phase 11 consumer dashboard) — the
# merchant API base URL the browser fetches directly (only the unauthenticated
# `/checkout-sessions/:id/public`, `/checkout-sessions/:id/mandate`, and
# `/consumer/{mandates,payments}` routes; the browser never holds a merchant
# API key). Must be a `NEXT_PUBLIC_*` var — Next.js inlines it into the
# client bundle at build time. Not secret: it is only a base URL.
NEXT_PUBLIC_API_URL="http://localhost:3001"
